{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Ninja-Multi-Base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel"
      }
    },
    {
      "name": "Windows-Base",
      "hidden": true,
      "inherits": "Ninja-Multi-Base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "Linux-Base",
      "hidden": true,
      "inherits": "Ninja-Multi-Base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Clang-Windows",
      "inherits": "Windows-Base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "Clang-cl.exe",
        "CMAKE_LINKER": "lld-link.exe"
      }
    },
    {
      "name": "Clang-Linux",
      "inherits": "Linux-Base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "GCC-Linux",
      "inherits": "Linux-Base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "MSVC",
      "inherits": "Windows-Base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Clang-Win-Debug",
      "configurePreset": "Clang-Windows",
      "configuration": "Debug"
    },
    {
      "name": "Clang-Win-Release",
      "configurePreset": "Clang-Windows",
      "configuration": "Release"
    },
    {
      "name": "Clang-Win-RelWithDebInfo",
      "configurePreset": "Clang-Windows",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "Clang-Win-MinSizeRel",
      "configurePreset": "Clang-Windows",
      "configuration": "MinSizeRel"
    },
    {
      "name": "Clang-Linux-Debug",
      "configurePreset": "Clang-Linux",
      "configuration": "Debug"
    },
    {
      "name": "Clang-Linux-Release",
      "configurePreset": "Clang-Linux",
      "configuration": "Release"
    },
    {
      "name": "Clang-Linux-RelWithDebInfo",
      "configurePreset": "Clang-Linux",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "Clang-Linux-MinSizeRel",
      "configurePreset": "Clang-Linux",
      "configuration": "MinSizeRel"
    },
    {
      "name": "GCC-Debug",
      "configurePreset": "GCC-Linux",
      "configuration": "Debug"
    },
    {
      "name": "GCC-Release",
      "configurePreset": "GCC-Linux",
      "configuration": "Release"
    },
    {
      "name": "GCC-RelWithDebInfo",
      "configurePreset": "GCC-Linux",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "GCC-MinSizeRel",
      "configurePreset": "GCC-Linux",
      "configuration": "MinSizeRel"
    },
    {
      "name": "MSVC-Debug",
      "configurePreset": "MSVC",
      "configuration": "Debug"
    },
    {
      "name": "MSVC-Release",
      "configurePreset": "MSVC",
      "configuration": "Release"
    },
    {
      "name": "MSVC-RelWithDebInfo",
      "configurePreset": "MSVC",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "MSVC-MinSizeRel",
      "configurePreset": "MSVC",
      "configuration": "MinSizeRel"
    }
  ]
}
